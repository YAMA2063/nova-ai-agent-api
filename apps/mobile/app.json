{
  "expo": {
    "name": "NOVA AI Agent",
    "slug": "nova-ai-agent",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "nova",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "NOVA membutuhkan izin galeri untuk memilih dan menganalisis foto.",
          "cameraPermission": "NOVA membutuhkan izin kamera untuk mengambil foto secara langsung."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090E"
    },
    "android": {
      "package": "com.nova.aiagent",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090E"
      }
    },
    "ios": {
      "bundleIdentifier": "com.nova.aiagent"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52814ad1-8229-4d0f-a72d-f8149788179e"
      }
    }
  }
}
